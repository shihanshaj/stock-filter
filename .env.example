# StockLens Configuration
# Copy this file to .env and customize as needed

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./stocklens.db

# Chartink
CHARTINK_SCREENER_URL=https://chartink.com/screener/copy-intrinsic-value-stock-134?src=wassup
CHARTINK_PROCESS_URL=https://chartink.com/screener/process

# Request Configuration
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=30
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0

# Cache TTL (seconds)
MAPPING_CACHE_TTL=604800  # 7 days
CLASSIFICATION_CACHE_TTL=3600  # 1 hour

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
